# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# editor state
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local caches and browser output
.cache/
.turbo/
.eslintcache
/playwright-report/
/test-results/

# local credentials and tunnel state
.credentials/
credentials.json
.secrets/
.tunnel/
.mcp-tunnel/
.secure-mcp-tunnel/
tunnel-profile*

/dist/
/.wrangler/
/outputs/
/work/
/artifacts/*
!/artifacts/release-candidate/
!/artifacts/release-candidate/**
*.tsbuildinfo
